{
  "manifest_version": 3,
  "name": "InsightURL Assistant",
  "version": "1.0.0",
  "description": "Ask questions about the current webpage using InsightURL RAG chatbot.",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://athul93-insighturl-backend.hf.space/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InsightURL Assistant",
     "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
  }}
}